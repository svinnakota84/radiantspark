# Public browser settings, never put secret keys in VITE_ variables.
VITE_CONTACT_EMAIL=
VITE_AMAZON_US_TAG=
VITE_AMAZON_IN_TAG=
VITE_DEALS_FEED_URL=
VITE_LIFESTYLE_URL=https://svinnakota84.github.io/lifestylehub/
# Leave blank on a full-stack Netlify deployment to use /api/agents.
# GitHub Pages needs an HTTPS endpoint on a separate serverless host.
VITE_AGENT_API_URL=

# SERVER ONLY — configure in your hosting provider's protected environment settings.
COMPOSIO_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
COMPOSIO_USER_ID=
# Generate a unique owner access token of at least 32 characters; never commit it.
AGENT_ACCESS_TOKEN=
# Explicit origins for a Pages frontend calling the separate backend (no trailing slash).
AGENT_ALLOWED_ORIGINS=https://svinnakota84.github.io,https://radiantsparkllc.com
# Set approved toolkit slugs for every enabled role; empty means disabled.
# Role IDs: maya, arjun, sarah, rajesh, elena, vikram, priya, marcus, ananya, david.
COMPOSIO_ROLE_TOOLKITS={}
